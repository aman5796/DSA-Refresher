import heapq

class Solution:
    def networkDelayTime(self, times: list[list[int]], n: int, k: int) -> int:
        graph = [[] for _ in range(n + 1)]
        for u, v, w in times:
            graph[u].append((v, w))

        dist = [float('inf')] * (n + 1)
        dist[k] = 0
        pq = [(0, k)]

        while pq:
            d, node = heapq.heappop(pq)
            if d > dist[node]:
                continue
            for v, w in graph[node]:
                if d + w < dist[v]:
                    dist[v] = d + w
                    heapq.heappush(pq, (dist[v], v))

        ans = 0
        for i in range(1, n + 1):
            if dist[i] == float('inf'):
                return -1
            ans = max(ans, dist[i])
        return ans
