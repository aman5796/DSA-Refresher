from queue import Queue
class Solution:
    def canVisitAllRooms(self, rooms: list[list[int]]) -> bool:
        total_rooms = len(rooms)
        vis = [False for _ in range(total_rooms)]
        q = Queue()
        q.put(0)
        vis[0] = True
        while not q.empty():
            node = q.get()
            for room in rooms[node]:
                if not vis[room]:
                    q.put(room)
                    vis[room] = True
        return all(vis)
